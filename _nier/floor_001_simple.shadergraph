{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "48de62d453e74eb09035e927b53a7555",
    "m_Group": {
        "m_Id": "5dd9da32a4474fdd8b0a6d2705bcb734"
    },
    "m_Name": "MainLight_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1892.0,
            "y": -1010.0001831054688,
            "width": 239.00001525878907,
            "height": 350.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "bdefdc6180a1442797eba404c6d0c52b"
        },
        {
            "m_Id": "c7fb9cc6d04941fb96f57373f8c0e7cd"
        },
        {
            "m_Id": "0a722239457342398d185216060dcc81"
        },
        {
            "m_Id": "7511a43dd3af4840b937bcc0fb68f0c3"
        },
        {
            "m_Id": "589dfb9f33b44a3bb2d42fc867378325"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight_float",
    "m_FunctionSource": "ef47258f299aea9418a111aed2827b85",
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\r\n    Direction = float3(0.5, 0.5, 0);\r\n    Color = 1;\r\n    DistanceAtten = 1;\r\n    ShadowAtten = 1;\r\n#else\r\n#if SHADOWS_SCREEN\r\n    float4 clipPos = TransformWorldToHClip(WorldPos);\r\n    float4 shadowCoord = ComputeScreenPos(clipPos);\r\n#else\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n#endif\r\n    Light mainLight = GetMainLight();\r\n    Direction = mainLight.direction;\r\n    Color = mainLight.color;\r\n    DistanceAtten = mainLight.distanceAttenuation;\r\n    ShadowSamplingData shadowSamplingData = GetMainLightShadowSamplingData();\r\n    half4 shadowParams = GetMainLightShadowParams();\r\n    ShadowAtten = SampleShadowmap(TEXTURE2D_ARGS(_MainLightShadowmapTexture, sampler_MainLightShadowmapTexture), TransformWorldToShadowCoord(WorldPos), shadowSamplingData, shadowParams, false);\r\n#endif\n"
}

